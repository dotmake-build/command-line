{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": "DotMake.CommandLine/DotMake.CommandLine.csproj",
          "src": "../src"
        }
      ],
      "dest": "api", 
      "codeSourceBasePath": "../src/DotMake.CommandLine/", 
      "memberLayout": "separatePages",
      "categoryLayout": "nested",
      //"namespaceLayout": "nested", 
      //"outputFormat": "apiPage" //not working for custom templates
    }
  ],
  "build": {
    "content": [
      { "files": "*.{md,yml}" },
      { "files": "articles/**/*.{md,yml}" },
      { "files": "api/**/*.{md,yml}" },
      {
        //Handle separately because we use different src and dest
        "files": "*.md",
        "src": "api-md",
        "dest": "api"
      }
    ],
    "overwrite": [
      { "files": "overwrites/*.md" }
    ],
    "resource": [
      { "files": "images/**" }
    ],
    "xref": [
      //This is only used for xref references in custom markdown files:
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "docfx-plus"
    ],
    "globalMetadata": {
      "_appName": "DotMake Command-Line",
      "_appTitle": "DotMake Command-Line",
      "_appLogoPath": "images/logo32.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "Copyright © 2023-2026 DotMake",
      "_enableSearch": true,
      "_appIconLinks": [
        {
          "icon": "github",
          "href": "https://github.com/dotmake-build/command-line",
          "title": "GitHub"
        }
      ]
    }
  }
}